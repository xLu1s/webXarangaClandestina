---
import '../styles/global.css';
import { content } from '../data/content';
import type { FaqItem, Crumb } from '../data/seo';
import { buildJsonLd, hreflangLinks, pageCanonical } from '../data/seo';
import { localizedPath, type RouteId } from '../data/routes';
import { siteConfig, type Locale } from '../data/site';

interface Props {
  locale?: Locale;
  route?: RouteId;
  title?: string;
  description?: string;
  faqs?: readonly FaqItem[];
  crumbs?: readonly Crumb[];
  noindex?: boolean;
  preloadImage?: string;
}

const {
  locale = 'es',
  route = 'home',
  title,
  description,
  faqs,
  crumbs,
  noindex = false,
  preloadImage,
} = Astro.props;

const copy = content[locale];
const pageTitle = title ?? copy.seo.title;
const pageDescription = description ?? copy.seo.description;
const canonical = pageCanonical(route, locale);
const alternates = hreflangLinks(route);
const ogImage = new URL('/og-default.webp', siteConfig.url).href;
const alternateLocale = locale === 'es' ? 'va' : 'es';
const homeCrumb = locale === 'va' ? 'Inici' : 'Inicio';
const breadcrumb = crumbs ?? (route === 'home'
  ? undefined
  : [
      { name: homeCrumb, path: localizedPath('home', locale) },
      { name: pageTitle, path: localizedPath(route, locale) },
    ]);

const jsonLd = buildJsonLd({
  route,
  locale,
  title: pageTitle,
  description: pageDescription,
  organizationDescription: content.es.seo.description,
  crumbs: noindex ? undefined : breadcrumb,
  faqs: noindex ? undefined : faqs,
});
---

<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#00C2CB" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/bricolage-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.legalName} />
    <meta property="og:locale" content={copy.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteConfig.legalName} />
    <meta property="og:locale:alternate" content={content[alternateLocale].locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-S15P5X5WN5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-S15P5X5WN5');
    </script>

    {!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
