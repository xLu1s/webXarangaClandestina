---
import type { SiteContent } from '../data/content';
interface Props { copy: SiteContent; }
const { copy } = Astro.props;
---

<section class="about section-pad">
  <div class="shell about-grid">
    <div>
      <p class="eyebrow"><span></span>{copy.about.eyebrow}</p>
      <h2 class="display-title">{copy.about.title}</h2>
    </div>
    <div class="about-copy">
      <p class="lead">{copy.about.lead}</p>
      <p>{copy.about.text}</p>
      <div class="round-stamp" aria-hidden="true"><span>{copy.about.stamp}</span><strong>LC</strong></div>
    </div>
  </div>
</section>
