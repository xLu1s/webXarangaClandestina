---
import type { SiteContent } from '../data/content';
import { media } from '../data/media';
import type { Locale } from '../data/site';
interface Props { copy: SiteContent; locale: Locale; }
const { copy, locale } = Astro.props;
const altFor = (item: typeof media.gallery[number]) => locale === 'va' ? item.altVa : item.altEs;
---

<section id="galeria" class="gallery section-pad">
  <div class="shell">
    <div class="section-heading split-heading gallery-heading">
      <div><p class="eyebrow"><span></span>{copy.gallery.eyebrow}</p><h2 class="display-title">{copy.gallery.title}</h2></div>
      <p>{copy.gallery.text}</p>
    </div>

    <div class="action-video-grid">
      {media.gallery.map((item, index) => (
        <button class="action-video gallery-trigger" data-type={item.type} data-src={item.src} data-alt={altFor(item)} aria-label={altFor(item)}>
          <span class="action-video-media">
            <img src={item.poster} alt={altFor(item)} loading="lazy" width="720" height="1280" />
            <span class="tile-play" aria-hidden="true">▶</span>
            <span class="tile-index">0{index + 1}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label={copy.gallery.title} aria-hidden="true">
  <button class="lightbox-close" id="lightbox-close" aria-label={copy.gallery.close}>×</button>
  <div class="lightbox-content" id="lightbox-content"></div>
</div>

<script>
  const lightbox = document.querySelector<HTMLElement>('#lightbox');
  const lightboxContent = document.querySelector<HTMLElement>('#lightbox-content');
  const closeButton = document.querySelector<HTMLButtonElement>('#lightbox-close');
  let lastTrigger: HTMLButtonElement | null = null;

  const closeLightbox = () => {
    if (!lightbox || !lightboxContent) return;
    lightbox.setAttribute('aria-hidden', 'true');
    lightboxContent.replaceChildren();
    document.body.classList.remove('no-scroll');
    lastTrigger?.focus();
  };

  document.querySelectorAll<HTMLButtonElement>('.gallery-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!lightbox || !lightboxContent) return;
      lastTrigger = trigger;
      const source = trigger.dataset.src ?? '';
      const alt = trigger.dataset.alt ?? '';
      const element = trigger.dataset.type === 'video' ? document.createElement('video') : document.createElement('img');
      if (element instanceof HTMLVideoElement) {
        element.controls = true;
        element.autoplay = true;
        element.playsInline = true;
      } else {
        element.alt = alt;
      }
      element.src = source;
      lightboxContent.replaceChildren(element);
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.classList.add('no-scroll');
      closeButton?.focus();
    });
  });
  closeButton?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeLightbox(); });
</script>
