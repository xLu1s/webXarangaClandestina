---
import type { SiteContent } from '../data/content';
import { media } from '../data/media';

interface Props { copy: SiteContent; }
const { copy } = Astro.props;
---

<section id="inicio" class="hero section-pad">
  <div class="hero-shape hero-shape-one" aria-hidden="true"></div>
  <div class="hero-shape hero-shape-two" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy reveal">
      <p class="eyebrow"><span></span>{copy.hero.eyebrow}</p>
      <h1>{copy.hero.titleStart} <em>{copy.hero.titleAccent}</em> {copy.hero.titleEnd}</h1>
      <p class="hero-intro">{copy.hero.text}</p>
      <div class="hero-actions">
        <a class="button button-dark" href="#contacto">{copy.hero.cta}<span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#galeria"><span class="play-dot" aria-hidden="true">▶</span>{copy.hero.secondary}</a>
      </div>
    </div>

    <div class="hero-media reveal reveal-late">
      <div class="video-kicker"><span>LIVE</span>{copy.hero.mediaLabel}</div>
      <div class="video-frame">
        <img src={media.hero.image} alt={copy.hero.photoAlt} width="1200" height="1500" fetchpriority="high" />
      </div>
      <p class="video-caption"><span>01</span>{copy.hero.mediaCaption}</p>
    </div>
  </div>
</section>

<div class="event-ticker" aria-label={copy.hero.eyebrow}>
  <div class="ticker-track">
    {[...copy.hero.ticker, ...copy.hero.ticker].map((item) => <span>{item}<i aria-hidden="true">✦</i></span>)}
  </div>
</div>
