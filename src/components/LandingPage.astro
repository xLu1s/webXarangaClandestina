---
import type { Locale } from '../data/site';
import { content } from '../data/content';
import { landings, type LandingId } from '../data/landings';
import { media } from '../data/media';
import { localizedPath } from '../data/routes';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Contact from './Contact.astro';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props { locale: Locale; id: LandingId; }
const { locale, id } = Astro.props;
const copy = content[locale];
const page = landings[id][locale];
const home = localizedPath('home', locale);
const picture = id === 'moros' ? media.specialty : media.hero;
const asideHref = localizedPath(id === 'moros' ? 'zone' : 'moros', locale);
const crumbs = [
  { name: copy.nav.start, path: home },
  { name: page.crumb, path: localizedPath(id, locale) },
];
---

<Layout
  locale={locale}
  route={id}
  title={page.seo.title}
  description={page.seo.description}
  faqs={page.faqs}
  crumbs={crumbs}
  preloadImage={picture.image}
>
  <Header copy={copy} locale={locale} route={id} />
  <main>
    <section id="inicio" class="hero hero-long section-pad">
      <div class="hero-shape hero-shape-one" aria-hidden="true"></div>
      <div class="hero-shape hero-shape-two" aria-hidden="true"></div>
      <div class="shell hero-grid">
        <div class="hero-copy">
          <nav class="crumbs" aria-label={locale === 'va' ? 'Fil d’Ariadna' : 'Migas de pan'}>
            <a href={home}>{copy.nav.start}</a>
            <span aria-hidden="true">/</span>
            <span>{page.crumb}</span>
          </nav>
          <p class="eyebrow"><span></span>{page.eyebrow}</p>
          <h1>{page.h1.titleStart} <em>{page.h1.titleAccent}</em> {page.h1.titleEnd}</h1>
          <p class="hero-intro">{page.intro}</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#contacto">{copy.nav.contact}<span aria-hidden="true">↗</span></a>
            <a class="text-link" href={asideHref}>{page.aside.linkLabel}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero-media">
          <div class="video-kicker"><span>{page.kicker}</span>{page.caption}</div>
          <div class="video-frame">
            <img src={picture.image} alt={page.photoAlt} width={picture.width} height={picture.height} fetchpriority="high" />
          </div>
          <p class="video-caption"><span>01</span>{page.caption}</p>
        </div>
      </div>
    </section>

    <section class="about section-pad">
      <div class="shell about-grid">
        <div>
          <p class="eyebrow"><span></span>{page.about.eyebrow}</p>
          <h2 class="display-title">{page.about.title}</h2>
        </div>
        <div class="about-copy">
          {page.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="events section-pad">
      <div class="shell">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow"><span></span>{page.list.eyebrow}</p>
            <h2 class="display-title">{page.list.title}</h2>
          </div>
          <p>{page.list.text}</p>
        </div>
        <div class="event-list">
          {page.list.rows.map((row) => (
            <article class={`event-row event-${row.color}`}>
              <span class="event-number">{row.number}</span>
              <div><h3>{row.name}</h3></div>
              <p class="event-description">{row.text}</p>
              <span class="event-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
        {page.notes.map((note) => <p class="event-description">{note}</p>)}
      </div>
    </section>

    <section class="specialty section-pad">
      <div class="shell specialty-copy">
        <p class="eyebrow eyebrow-light"><span></span>{page.aside.eyebrow}</p>
        <h2 class="display-title">{page.aside.title}</h2>
        {page.aside.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a class="button button-yellow" href={asideHref}>{page.aside.linkLabel}<span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="trust section-pad" id="preguntas">
      <div class="shell">
        <p class="eyebrow"><span></span>{locale === 'va' ? 'Preguntes freqüents' : 'Preguntas frecuentes'}</p>
        <h2 class="display-title trust-title">{locale === 'va' ? 'El que la web sí pot dir.' : 'Lo que la web sí puede decir.'}</h2>
        <div class="event-list faq-list">
          {page.faqs.map((faq, index) => (
            <article class="event-row">
              <span class="event-number">0{index + 1}</span>
              <div><h3>{faq.question}</h3></div>
              <p class="event-description">{faq.answer}</p>
              <span class="event-arrow" aria-hidden="true">?</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Contact copy={copy} showInstagram />
  </main>
  <Footer copy={copy} locale={locale} route={id} />
  <WhatsAppButton copy={copy} />
</Layout>
